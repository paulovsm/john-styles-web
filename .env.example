# ─────────────────────────────────────────────────────────────
# Server-side only (NEVER prefixed with VITE_ — not exposed to client)
# ─────────────────────────────────────────────────────────────

# Google AI (Gemini)
GOOGLE_AI_API_KEY=your_api_key_here

# Firebase Admin service account — required for API auth + server-side usage
# limits. Paste the full service account JSON, or a base64-encoded version.
FIREBASE_SERVICE_ACCOUNT=

# N8N Webhook URL (John Styles chat agent) — proxied via /api/chat
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/john-styles-chat

# Comma-separated list of allowed origins for CORS (production domains).
# Localhost dev origins are allowed automatically outside production.
ALLOWED_ORIGINS=https://your-production-domain.com

# ─────────────────────────────────────────────────────────────
# Client-side (VITE_ prefixed — bundled into the app; Firebase web keys are
# not secrets, security relies on Firestore/Storage rules)
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
