# ─────────────────────────────────────────────────────────────
# Server-side only (NEVER prefixed with VITE_ — not exposed to client)
# ─────────────────────────────────────────────────────────────

# Google AI (Gemini)
GOOGLE_AI_API_KEY=your_api_key_here

# Firebase Admin service account — required for API auth + server-side usage
# limits. Paste the full service account JSON, or a base64-encoded version.
FIREBASE_SERVICE_ACCOUNT=

# N8N Webhook URL (John Styles chat agent) — proxied via /api/chat
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/john-styles-chat

# Comma-separated list of allowed origins for CORS (production domains).
# Localhost dev origins are allowed automatically outside production.
ALLOWED_ORIGINS=https://your-production-domain.com

# Canonical public origin for the server-rendered blog (canonical tags, Open
# Graph URLs, sitemap). Set this in production: without it those URLs are built
# from the request Host header, which a client can spoof — and the blog pages
# are served with a shared CDN cache.
PUBLIC_SITE_URL=https://your-production-domain.com

# Transactional email for the Fleek for Companies contact form. Verify the
# sender domain in Resend before using a fleekauthority.com address in production.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="Fleek Authority <contato@fleekauthority.com>"
CONTACT_EMAIL=contato@fleekauthority.com

# Google Calendar integration (OAuth 2.0 Web client with the Calendar readonly
# scope). Redirect URI must match the one registered in Google Cloud, e.g.
# http://localhost:3000/api/calendar-callback (dev) or https://<domain>/api/calendar-callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar-callback
OAUTH_STATE_SECRET=change-me-to-a-long-random-string
# Where to send the user back after the OAuth callback (the web app origin)
APP_BASE_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Client-side (VITE_ prefixed — bundled into the app; Firebase web keys are
# not secrets, security relies on Firestore/Storage rules)
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
